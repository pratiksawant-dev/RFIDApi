{
  "extends": null,
  "appId": "com.loyalstring.sparkle-rfid-dashboard.offline",
  "productName": "Sparkle RFID Dashboard Offline",
  "directories": {
    "output": "release-offline"
  },
  "artifactName": "${productName}-${version}-Setup.${ext}",
  "files": [
    "build/**/*",
    "electron/**/*",
    "build-resources/icon.png",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "rfid-bridge/bin/Release/net8.0/win-x64/publish",
      "to": "rfid-bridge",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": "nsis",
    "icon": "build-resources/icon.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sparkle RFID (Offline)",
    "menuCategory": "Sparkle RFID",
    "runAfterFinish": true,
    "unicode": true,
    "displayLanguageSelector": false,
    "warningsAsErrors": false,
    "include": "build-resources/installer.nsh",
    "installerSidebar": "build-resources/installerSidebar.bmp",
    "uninstallerSidebar": "build-resources/installerSidebar.bmp",
    "installerHeader": "build-resources/installerHeader.bmp",
    "installerIcon": "build-resources/icon.ico",
    "uninstallerIcon": "build-resources/icon.ico",
    "installerHeaderIcon": "build-resources/icon.ico"
  }
}
