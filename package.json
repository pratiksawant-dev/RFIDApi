{
  "name": "sparkle-rfid-dashboard",
  "homepage": ".",
  "main": "electron/main.js",
  "version": "0.1.89",
  "private": true,
  "proxy": "http://3.109.131.101:816",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@react-pdf/renderer": "^4.3.0",
    "@syncfusion/ej2-base": "^31.2.5",
    "@syncfusion/ej2-charts": "^31.2.10",
    "@syncfusion/ej2-react-charts": "^31.2.10",
    "@syncfusion/ej2-react-popups": "^31.2.5",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.6.2",
    "bootstrap": "^5.3.2",
    "chart.js": "^4.5.0",
    "electron-updater": "^6.8.3",
    "face-api.js": "^0.22.2",
    "firebase": "^11.9.0",
    "framer-motion": "^12.16.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "is-number": "^7.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^1.34.0",
    "nodemailer": "^7.0.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.20.0",
    "react-toastify": "^9.1.3",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "dev": "npm run start:electron:fast",
    "dev:online": "set \"REACT_APP_API_MODE=online\" && npm run start:electron:fast",
    "dev:offline": "set \"REACT_APP_API_MODE=offline\" && npm run start:electron:fast",
    "start": "craco start",
    "start:fast": "set \"FAST_REFRESH=false\" && set \"GENERATE_SOURCEMAP=false\" && set \"DISABLE_ESLINT_PLUGIN=true\" && craco start",
    "start:electron": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "start:electron:fast": "concurrently \"npm run start:fast\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "craco build",
    "build:web": "craco build",
    "build:web:online": "npx --yes env-cmd@10 -f .env.online -- craco build",
    "build:web:offline": "npx --yes env-cmd@10 -f .env.offline -- craco build",
    "build:bridge": "node scripts/prepare-rfid-bridge.js",
    "build:bridge:modern": "set \"RFID_BRIDGE_FRAMEWORK=net8.0\" && node scripts/prepare-rfid-bridge.js",
    "build:bridge:legacy": "set \"RFID_BRIDGE_FRAMEWORK=net6.0\" && node scripts/prepare-rfid-bridge.js",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "build:electron:only": "npm run build:icon && npm run build:bridge && npm run build:web && electron-builder --win",
    "build:electron:online": "npx --yes env-cmd@10 -f .env.online -- cmd /c \"npm run version:patch && npm run build:icon && npm run build:bridge && craco build && electron-builder --win --config electron-builder.online.json\"",
    "build:electron:offline": "npx --yes env-cmd@10 -f .env.offline -- cmd /c \"npm run version:patch && npm run build:icon && npm run build:bridge && craco build && electron-builder --win --config electron-builder.offline.json\"",
    "build:electron:both": "npm run build:electron:online && npm run build:electron:offline",
    "build:electron": "npm run build:electron:online",
    "build:electron:modern": "npm run version:patch && npm run build:icon && npm run build:bridge:modern && npm run build:web && electron-builder --win",
    "build:electron:legacy": "npm run version:patch && npm run build:icon && npm run build:bridge:legacy && npm run build:web && electron-builder --win --config electron-builder.legacy.json",
    "release:patch": "npm run version:patch && npm run build:electron:only",
    "release:minor": "npm run version:minor && npm run build:electron:only",
    "release:major": "npm run version:major && npm run build:electron:only",
    "dist": "npm run build:electron",
    "build:icon": "node scripts/generate-electron-icon.js",
    "test": "craco test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "http-proxy-middleware": "^4.1.0",
    "png-to-ico": "^3.0.1",
    "react-scripts": "5.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.5"
  },
  "installConfig": {
    "legacyPeerDeps": true
  },
  "build": {
    "extends": null,
    "appId": "com.loyalstring.sparkle-rfid-dashboard",
    "productName": "Sparkle RFID Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "rfid-bridge/bin/Release/net8.0/win-x64/publish",
        "to": "rfid-bridge",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico"
    }
  }
}
